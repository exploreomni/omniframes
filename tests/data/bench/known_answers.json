  "answers": {
    "grand_totals": {
      "description": "Grand totals over the whole fact table: revenue, row count, distinct buyers, quantity. distinct_buyers mirrors the users.count measure (COUNT DISTINCT users.id, so orphan user_ids do not count); distinct_user_ids is the raw fact-column cardinality.",
      "sql": "SELECT SUM(oi.sale_price) AS total_sale_price, COUNT(*) AS order_items_count, COUNT(DISTINCT u.id) AS distinct_buyers, COUNT(DISTINCT oi.user_id) AS distinct_user_ids, SUM(oi.quantity) AS total_quantity, COUNT(DISTINCT p.id) AS distinct_products FROM order_items oi LEFT JOIN users u ON u.id = oi.user_id LEFT JOIN products p ON p.id = oi.product_id",
      "columns": [
        "total_sale_price",
        "order_items_count",
        "distinct_buyers",
        "distinct_user_ids",
        "total_quantity",
        "distinct_products"
      ],
      "row_count": 1,
